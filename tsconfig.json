{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["koala/*"],
      "koala-icons": ["koala/icons/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "ui/**/*.tsx", "koala/**/*.ts", "koala/**/*.tsx"]
}
